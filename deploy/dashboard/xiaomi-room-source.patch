+import { RoomConfig } from "../types/types";
+
+export interface RoomSourceSnapshot {
+    key: string;
+    mapId: string;
+    revision: string;
+    rooms: RoomConfig[];
+}
+
+// MQTT attributes are data, never configuration or executable templates.
+export function readRoomSource(entity: { state: string; attributes: Record<string, unknown> } | undefined): RoomSourceSnapshot | undefined {
+    if (!entity || ["unknown", "unavailable"].includes(entity.state)) return undefined;
+    const { map_id: mapId, revision, rooms: rawRooms, coordinate_space: coordinateSpace } = entity.attributes;
+    const safePin = (value: unknown): value is string =>
+        typeof value === "string" && value.length > 0 && value.length <= 256 && /^[A-Za-z0-9_.:-]+$/.test(value);
+    if (!safePin(mapId) || !safePin(revision) || coordinateSpace !== "display_pixels"
+        || !Array.isArray(rawRooms) || rawRooms.length === 0 || rawRooms.length > 32) return undefined;
+    const ids = new Set<number>();
+    const rooms: RoomConfig[] = [];
+    for (const raw of rawRooms) {
+        if (raw === null || typeof raw !== "object") return undefined;
+        const { id, outline } = raw;
+        if (!Number.isInteger(id) || id < 0 || id > 255 || ids.has(id)
+            || !Array.isArray(outline) || outline.length < 3 || outline.length > 65536) return undefined;
+        const points: [number, number][] = [];
+        for (const point of outline) {
+            if (!Array.isArray(point) || point.length !== 2
+                || !point.every(v => typeof v === "number" && Number.isFinite(v) && v >= 0 && v <= 4096)) return undefined;
+            points.push([point[0], point[1]]);
+        }
+        ids.add(id);
+        let displayLabel: RoomConfig["label"];
+        const { name, label } = raw;
+        // ASCII names are already rasterized. Other names remain escaped SVG text.
+        if (typeof name === "string" && name.length > 0 && name.length <= 128
+            && /[^\x00-\x7f]/.test(name) && !/[\x00-\x1f\x7f-\x9f]/.test(name)
+            && label !== null && typeof label === "object") {
+            const { x, y } = label;
+            if ([x, y].every(v => typeof v === "number" && Number.isFinite(v) && v >= 0 && v <= 4096)) {
+                displayLabel = { text: name, x, y, offset_x: 0, offset_y: 0 };
+            }
+        }
+        // Ignore incoming label text/options, actions, variables and default selections.
+        rooms.push({ id, outline: points, default_state: "unselected" as RoomConfig["default_state"],
+            ...(displayLabel ? { label: displayLabel } : {}) });
+    }
+    return { key: JSON.stringify([mapId, revision, rooms]), mapId, revision, rooms };
+}
